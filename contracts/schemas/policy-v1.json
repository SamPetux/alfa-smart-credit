{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alfa-smart-credit.local/contracts/schemas/policy-v1.json",
  "title": "PolicyV1",
  "description": "Демонстрационная кредитная политика. Числа учебные, не банковский стандарт.",
  "version": "policy-v1",
  "products": {
