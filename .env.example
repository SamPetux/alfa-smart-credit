# Copy to .env for local non-Compose runs. Never commit real secrets.
DATABASE_URL=postgresql+psycopg://alfa:alfa@127.0.0.1:5432/alfa_credit
DEMO_MODE=true
APP_ENV=local
# production: DEMO_MODE=false, COOKIE_SECURE=true, SESSION_SECRET≠change-me-demo-only
SESSION_SECRET=change-me-demo-only
SESSION_TTL_SECONDS=28800
COOKIE_SECURE=false
SESSION_COOKIE_NAME=asc_session
DOCUMENTS_DIR=data/documents
FIXTURES_ROOT=
JOB_MAX_ATTEMPTS=3
JOB_LEASE_SECONDS=60
WORKER_POLL_SECONDS=2
LOG_LEVEL=INFO
